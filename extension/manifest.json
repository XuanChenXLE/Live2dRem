{
  "manifest_version": 3,
  "name": "Rem 看板娘",
  "version": "1.0.0",
  "description": "在任何网页右下角召唤蕾姆（本地规则聊天，离线可用）",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Rem 看板娘",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://v1.hitokoto.cn/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["rem.html", "live2d/*", "live2d/**/*", "vendor/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
